# Windsurf Gateway 环境变量配置
# 复制此文件为 .env 并修改

# ===========================================
# 服务器配置
# ===========================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_MODE=release
SERVER_READ_TIMEOUT=30
SERVER_WRITE_TIMEOUT=300
SERVER_IDLE_TIMEOUT=120

# ===========================================
# MySQL 数据库配置
# ===========================================
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=windsurf_gateway

# ===========================================
# Redis 配置
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

# ===========================================
# 管理员配置
# ===========================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=

# ===========================================
# JWT 认证配置
# ===========================================
JWT_SECRET=change-me-to-a-random-secret-string
JWT_EXPIRES_IN=86400
JWT_REFRESH_EXPIRES_IN=604800

# ===========================================
# 代理配置
# ===========================================
PROXY_TIMEOUT=300
PROXY_MAX_IDLE_CONNS=100
PROXY_MAX_IDLE_CONNS_PER_HOST=10
PROXY_IDLE_CONN_TIMEOUT=90
FORWARD_DISABLED=false
ENABLE_CUSTOM_USER_AGENT=false
SCHEDULE_TASK_ENABLED=true

# ===========================================
# 前端配置
# ===========================================
FRONTEND_URL=http://localhost:8080
FRONTEND_STATIC_PATH=./web/dist
API_PREFIX=/api

# ===========================================
# 用户认证配置
# ===========================================
USER_AUTH_PASSWORD_MIN_LENGTH=6
USER_AUTH_PASSWORD_MAX_LENGTH=32

# ===========================================
# Telegram 通知（可选）
# ===========================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false

# ===========================================
# Cloudflare Turnstile（可选）
# ===========================================
TURNSTILE_SECRET_KEY=
TURNSTILE_ENABLED=false

# ===========================================
# 日志配置
# ===========================================
LOG_ENABLED=true
LOG_LEVEL=info
LOG_FORMAT=console
